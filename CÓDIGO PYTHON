59# 2) Sentimento baseline (lexicon simples)
60def normalize_text(s):
61    if not isinstance(s, str):
62        s = ""
63    s = s.lower()
64    s = "".join(ch for ch in unicodedata.normalize("NFD", s) if unicodedata.category(ch) != "Mn")
65    s = re.sub(r"[^a-z0-9\s]", " ", s)
66    s = re.sub(r"\s+", " ", s).strip()
67    return s
68
69POS = {
70    "alta","subiu","subir","ganho","ganhos","lucro","lucros","recorde","crescimento","melhora","positivo",
71    "otimista","expansao","valorizacao","valorizou","avanco","avancou","supera","superou","forte"
72}
73NEG = {
74    "queda","caiu","cair","perda","perdas","prejuizo","prejuizos","fraude","crise","negativo","pessimista",
75    "recuo","recuou","despenca","despencou","investigacao","multa","risco","pressao","fraco","piora"
76}
77
78def sentiment_score(text):
79    txt = normalize_text(text)
80    if txt == "":
81        return 0.0, 0, 0
82    tokens = txt.split()
83    pos_count = sum(1 for w in tokens if w in POS)
84    neg_count = sum(1 for w in tokens if w in NEG)
85    denom = max(1, len(tokens))
86    score = (pos_count - neg_count) / denom
87    return float(score), int(pos_count), int(neg_count)
88
