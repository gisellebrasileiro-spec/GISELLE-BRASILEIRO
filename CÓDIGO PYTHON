18def google_news_rss(query, hl="pt-BR", gl="BR", ceid="BR:pt-419"):
19    q = quote(query)
20    url = f"https://news.google.com/rss/search?q={q}&hl={hl}&gl={gl}&ceid={ceid}"
21    r = requests.get(url, timeout=30)
22    r.raise_for_status()
23    return r.text
