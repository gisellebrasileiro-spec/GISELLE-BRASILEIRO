12def brapi_history(ticker, range_str="5y", interval="1d", token=""):
13    url = f"https://brapi.dev/api/quote/{ticker}"
14    params = {"range": range_str, "interval": interval, "token": token}
15    r = requests.get(url, params=params, timeout=30)
16    r.raise_for_status()
17    js = r.json()
18    msg = js.get("message", "")
19    if isinstance(msg, str) and msg.strip():
20        raise RuntimeError(msg)
21
22    results = js.get("results", [])
23    if not isinstance(results, list) or len(results) == 0:
24        return pd.DataFrame()
25
26    hist = results[0].get("historicalDataPrice", [])
27    if not isinstance(hist, list) or len(hist) == 0:
28        return pd.DataFrame()
29
30    df = pd.DataFrame(hist)
31    df.columns = [c.lower() for c in df.columns]
32    df["date"] = pd.to_datetime(df["date"], unit="s", errors="coerce")
33    df = df.dropna(subset=["date"]).sort_values("date").set_index("date")
34
35    for c in ["open","high","low","close","volume"]:
36        if c not in df.columns:
37            df[c] = np.nan
38    return df[["open","high","low","close","volume"]].copy()
39
40def sma(s, window): return s.rolling(window=window).mean()
41def ema(s, span): return s.ewm(span=span, adjust=False).mean()
42
43def rsi(close, period=14):
44    delta = close.diff()
45    gain = delta.where(delta > 0, 0.0)
46    loss = (-delta).where(delta < 0, 0.0)
47    avg_gain = gain.rolling(window=period).mean()
48    avg_loss = loss.rolling(window=period).mean()
49    rs = avg_gain / avg_loss.replace(0, np.nan)
50    return 100 - (100 / (1 + rs))
51
52def macd(close, fast=12, slow=26, signal=9):
53    fast_ema = ema(close, fast)
54    slow_ema = ema(close, slow)
55    macd_line = fast_ema - slow_ema
56    signal_line = ema(macd_line, signal)
57    hist = macd_line - signal_line
58    return macd_line, signal_line, hist
59
60def bollinger(close, window=20, n_std=2):
61    mid = sma(close, window)
62    std = close.rolling(window=window).std()
63    upper = mid + n_std * std
64    lower = mid - n_std * std
65    return mid, upper, lower
