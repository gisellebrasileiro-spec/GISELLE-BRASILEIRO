118def make_pos(series_signal, buy_level, sell_level):
119    pos = 0
120    out = []
121    for v in series_signal:
122        v = float(v)
123        if v >= buy_level:
124            pos = 1
125        elif v <= sell_level:
126            pos = 0
127        out.append(pos)
128    return out
