25def parse_rss(xml_text, ticker):
26    root = ET.fromstring(xml_text)
27    channel = root.find("channel")
28    items = channel.findall("item") if channel is not None else []
29    rows = []
30    for it in items:
31        title = (it.findtext("title") or "").strip()
32        link = (it.findtext("link") or "").strip()
33        pubDate = (it.findtext("pubDate") or "").strip()
34        source_el = it.find("source")
35        source = (source_el.text or "").strip() if source_el is not None else ""
36        dt = pd.to_datetime(pubDate, errors="coerce")
37        rows.append({
38            "ticker": ticker,
39            "datetime": dt,
40            "headline": title,
41            "source": source,
42            "url": link,
43            "query": QUERIES[ticker]
44        })
45    return rows
